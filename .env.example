# Copie para .env e preencha. O .env NÃO vai para o Git.

# ---- Banco ----
POSTGRES_DB=aquario
POSTGRES_USER=aquario
POSTGRES_PASSWORD=troque-esta-senha

# ---- Broker (usuários MQTT; as senhas também vão para firmware/*/secrets.h) ----
# DNS ou IP pelo qual os ESP32 chegam ao broker (entra no certificado)
MQTT_PUBLIC_HOST=aquario.exemplo.com
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=troque-backend
MQTT_SONDA_PASSWORD=troque-sonda
MQTT_CTRL_PASSWORD=troque-ctrl

# ---- Backend / interface ----
# A interface e a API NÃO têm login: quem acessa esta porta pode comandar o aquário.
# Exponha só na rede local ou atrás de VPN/firewall.
BACKEND_PORT=8000
# URL pela qual o ESP32 baixa o firmware na OTA (R17). Use https se houver proxy TLS na frente.
PUBLIC_BASE_URL=http://aquario.exemplo.com:8000

# ---- WhatsApp (CallMeBot, R15) — vazio = só registra os alertas ----
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
